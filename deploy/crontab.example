# Replacement for vercel.json "crons" now that the app is self-hosted.
# Vercel used to hit these endpoints; a plain system cron does the same.
#
# Install:  crontab -e   (then paste the lines below)
# Set CRON_SECRET in .env.local to the same value used here.
#
# Times are the server's local timezone — check with `timedatectl`.
# Original schedules were UTC on Vercel; adjust if your server isn't UTC.

CRON_SECRET=change-me-to-match-.env.local

# Transfer orders: pull BC, record detection times, close received ones, notify stores.
# Runs all day on purpose: it is cheap when nothing changed, and a store can be
# staffed at any hour. (-m 120 caps a hung BC call so runs can't pile up.)
*/5 * * * * curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/transfer-orders > /dev/null

# Break reminders: "istirahat sudah 30 menit — kembali & absen masuk" bell notification
# for employees whose app is closed (an open app gets it from its own 60 s bell poll).
*/5 * * * * curl -fsS -m 60 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/break-reminders > /dev/null

# Cek Bin monthly round: refresh each store's BC bin list (~daily, in the background), read the month's
# scans into the saved monthly stats, freeze last month once it is over.
12 * * * * curl -fsS -m 120 -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/bin-check > /dev/null

 5 0 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/revert-transfers      > /dev/null
30 0 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/cleanup-task-images   > /dev/null
45 0 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/auto-checkout         > /dev/null
50 0 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/auto-absent           > /dev/null
55 0 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/notifications-cleanup > /dev/null
 0 1 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/password-expiry-check > /dev/null
